# 377-ARCHIVE Phase 2: Cloud Run Job image for the 小林誠司 名言 mail lane.
# GCS read-only + Gmail SMTP via mail_delivery_bridge. LLM 不要、 X API 不要。
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY config/ ./config/
COPY vendor/ ./vendor/

RUN useradd --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/logs /app/data /tmp/kobayashi_meigen \
    && chown -R appuser:appuser /app /home/appuser /tmp/kobayashi_meigen

USER appuser

CMD ["python3", "-m", "src.tools.run_kobayashi_meigen_mail"]
