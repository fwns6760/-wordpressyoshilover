# 347 — Cloud Run Job image for the セ・リーグ X post candidate mail lane.
# Pure Python stdlib + insight.db (GCS-backed) read-only + Gmail SMTP via
# mail_delivery_bridge. Never calls Gemini, X API, or article publish path.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY config/ ./config/
COPY vendor/ ./vendor/

RUN useradd --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/logs /app/data /tmp/x_post_mail \
    && chown -R appuser:appuser /app /home/appuser /tmp/x_post_mail

USER appuser

# Cloud Run Job entrypoint — single send-and-exit cycle.
CMD ["python3", "-m", "src.tools.run_x_post_mail"]
