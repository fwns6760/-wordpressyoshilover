# Cloud Run Job image for YOSHILOVER Giants news candidate mail.
# Metadata-only collection: no article body generation, no WordPress mutation, no X posting.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY config/ ./config/
COPY vendor/ ./vendor/

RUN useradd --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/logs /tmp/yoshilover_news_candidates \
    && chown -R appuser:appuser /app /home/appuser /tmp/yoshilover_news_candidates

USER appuser

ENTRYPOINT ["python3", "-m", "src.tools.run_yoshilover_news_candidates_mail"]
CMD []
